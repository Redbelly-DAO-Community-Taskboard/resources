{
  "name": "redbelly-dao-hardhat-starter",
  "version": "1.0.0",
  "description": "Pre-configured Hardhat starter for Redbelly Network DAO task board contributors",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.js --network redbelly-testnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network redbelly-mainnet",
    "verify": "hardhat verify --network redbelly-testnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.22.0",
    "dotenv": "^16.4.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0"
  }
}
